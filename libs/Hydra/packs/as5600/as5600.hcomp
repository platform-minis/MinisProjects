hcomp: "0.1"
component: as5600
name: AS5600
package: SOIC-8
pins:
  - { name: VCC,  kind: power_in }
  - { name: GND,  kind: ground }
  - { name: SDA,  kind: bidirectional, bus: i2c, role: sda }
  - { name: SCL,  kind: input,         bus: i2c, role: scl }
  - { name: OUT,  kind: output, optional: true, description: Wyjście analogowe albo PWM }
  - { name: DIR,  kind: input,  optional: true, description: Kierunek zliczania }
